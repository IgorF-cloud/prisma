# Só vale em desenvolvimento (`npm run dev`). O instalador NUNCA empacota
# o .env. Copie para `.env` e aponte para o seu servidor:
#
#   cp .env.example .env
#
# Sem estas variáveis o app usa os endereços compilados em
# src/main/config.ts.

# A API do prisma_server (atrás do nginx).
API_BASE_URL=http://localhost:5000
# O LiveKit (direto, sem passar pelo nginx).
LIVEKIT_WS_URL=ws://localhost:5880
