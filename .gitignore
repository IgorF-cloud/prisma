# Dependências e saídas de build
node_modules
dist
out
*.tsbuildinfo

# Segredos e configuração local
.env
.env.*
!.env.example

# Instalador: o script do Inno (prisma.iss), o coletor do GStreamer e as
# artes do wizard VÃO pro git. Ficam de fora só os binários — o GStreamer
# embarcado (36 MB, gerado por collect-gstreamer.ps1) e o Prisma-Setup.exe
# (97 MB, a 3 MB do limite de arquivo do GitHub) — e o certificado de
# code-signing, que é de cada um (ver README).
/installer/gstreamer/
/installer/output/*
!/installer/output/.gitkeep
/installer/certs/
/installer/getSHA256.txt

# Documentação interna de trabalho — fica só local
MEMORIA.md
RELEASE.md
ROADMAP.md

# Configuração de IDE / editor
/.idea
.vscode
.claude
*.code-workspace

# Ferramentas e SO
.eslintcache
*.log*
.DS_Store
Thumbs.db
desktop.ini

# Gerado pelo build (scripts/build-native-helper.mjs) a partir de
# native/PrismaWindows.cs — binario nao entra no repo.
resources/prisma-windows.exe
